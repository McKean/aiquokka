#!/bin/sh
# Depot test entry, mirroring CI (.github/workflows/ci.yml) order:
# gofmt gate first, then go vet, then go test, then the install script test.
set -eu

out=$(gofmt -l .)
if [ -n "$out" ]; then
  echo "gofmt needed on:"
  echo "$out"
  exit 1
fi

go vet ./... && go test ./...

# install.sh against local fixtures, no network.
sh install_test.sh
